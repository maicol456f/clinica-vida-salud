# Copie este archivo como .env para ejecutar en local
APP_ENV=development
APP_DEBUG=1
APP_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conexión a PostgreSQL (local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vida_salud
DB_USER=postgres
DB_PASSWORD=postgres
# En Render se usa DATABASE_URL en lugar de las variables DB_*
# DATABASE_URL=postgres://usuario:clave@host:5432/base

ADMIN_PASSWORD=Admin123!

# Bloqueo por intentos fallidos de inicio de sesión
MAX_INTENTOS=3
# 0 = la cuenta queda bloqueada hasta que un administrador la desbloquee (o el usuario recupere su contraseña por correo)
# N > 0 = se desbloquea sola pasados N minutos
LOCKOUT_MINUTES=0
SEED_DEMO=1
